# Copy to deploy/production/.env (gitignored) and fill in. Generate secrets with:
#   openssl rand -hex 32
# The API refuses to start in production while any required value is missing or a
# development default.

# --- Required -----------------------------------------------------------------------------
# Public domain (DNS A/AAAA record pointing at this server). Caddy gets the certificate.
CORPSEC_DOMAIN=corpsec.example.com
# Let's Encrypt account email (expiry warnings).
CORPSEC_ACME_EMAIL=admin@example.com
# Published in /.well-known/security.txt and the /bot page for abuse reports.
CORPSEC_SECURITY_CONTACT=security@example.com
# Database password: hex only (it goes into a URL). openssl rand -hex 24
CORPSEC_DB_PASSWORD=
# Signs opt-out tokens. openssl rand -hex 32
CORPSEC_SECRET_KEY=

# Outgoing email (sign-in links, alerts, digests). Any SMTP provider: Postmark, SES, Mailgun...
# Set up SPF, DKIM and DMARC for the sender domain or the links land in spam.
CORPSEC_SMTP_HOST=
CORPSEC_SMTP_PORT=587
CORPSEC_SMTP_USERNAME=
CORPSEC_SMTP_PASSWORD=
CORPSEC_SMTP_STARTTLS=true
CORPSEC_MAIL_FROM=CorpSEC <no-reply@corpsec.example.com>

# --- Optional -----------------------------------------------------------------------------
# WordPress vulnerability data (free key from wordfence.com, see README).
CORPSEC_WORDFENCE_API_KEY=
# Operator dashboard at /admin (JSON list of sign-in emails).
CORPSEC_ADMIN_EMAILS=["admin@example.com"]
# Prometheus scraping of GET /metrics (Authorization: Bearer <token>); empty = off.
CORPSEC_METRICS_TOKEN=
# Error tracking: a Sentry or self-hosted GlitchTip DSN; empty = off. No personal data is sent.
CORPSEC_SENTRY_DSN=

# Spam/phishing blocklist checks: without a key the free Spamhaus servers are used, which are
# for low-volume non-commercial use only. Commercial: get a Data Query Service key.
CORPSEC_SPAMHAUS_DQS_KEY=
# Open-port check from Shodan InternetDB (confirm its terms fit your offering first).
CORPSEC_INTERNETDB_ENABLED=false
# Sign in with Google / Microsoft. Redirect URIs to register:
#   https://<CORPSEC_DOMAIN>/api/v1/auth/oauth/google/callback
#   https://<CORPSEC_DOMAIN>/api/v1/auth/oauth/microsoft/callback
CORPSEC_GOOGLE_CLIENT_ID=
CORPSEC_GOOGLE_CLIENT_SECRET=
CORPSEC_MICROSOFT_CLIENT_ID=
CORPSEC_MICROSOFT_CLIENT_SECRET=
CORPSEC_MICROSOFT_TENANT=common

# Backups (pg_dump every night at 03:00 UTC).
CORPSEC_BACKUP_DIR=./backups
CORPSEC_BACKUP_KEEP_DAYS=14
