$TTL 60
@   IN SOA ns.dbl.spamhaus.org. admin.dbl.spamhaus.org. 1 3600 600 86400 60
@   IN NS  ns.dbl.spamhaus.org.
ns  IN A   172.30.0.53
corpsec-lab-bad.com  IN A 127.0.1.4
